{
  "name": "tauri-gb-boilerplate",
  "productName": "Tauri App",
  "version": "1.0.0",
  "description": "A secure, production-ready Tauri starter with React and TypeScript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "appConfig": {
    "appId": "com.gabrielbacha.tauri-app",
    "protocol": "tauri-app",
    "storageNamespace": "tauri-boilerplate",
    "destinations": {
      "repository": "https://github.com/gabrielbacha/Tauri-React-Boilerplate",
      "documentation": "https://github.com/gabrielbacha/Tauri-React-Boilerplate#readme",
      "license": "https://github.com/gabrielbacha/Tauri-React-Boilerplate/blob/main/LICENSE",
      "support": "https://github.com/gabrielbacha/Tauri-React-Boilerplate/issues"
    },
    "variant": "showcase"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "tauri build --no-bundle",
    "package": "tauri build --debug --no-bundle && node scripts/verify-package.mjs --debug",
    "make": "node scripts/make.mjs",
    "make:mac": "node scripts/make.mjs --mac",
    "make:win": "node scripts/make.mjs --win",
    "make:linux": "node scripts/make.mjs --linux",
    "release": "node scripts/release.mjs",
    "setup": "node scripts/setup.mjs",
    "bindings": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --example export_bindings -- src/shared/bindings.ts",
    "bindings:check": "node scripts/check-bindings.mjs",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm test && pnpm run rust:check && pnpm run bindings:check",
    "fix": "pnpm run lint:fix && pnpm run format:fix && pnpm run rust:fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:template": "node scripts/test-template.mjs",
    "rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "rust:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "verify:config": "node scripts/verify-config.mjs",
    "scaffold:feature": "node scripts/scaffold-feature.mjs",
    "clean": "node scripts/clean.mjs",
    "tauri": "tauri",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e:docker": "node scripts/test-e2e.mjs --docker"
  },
  "author": {
    "name": "gabrielbacha",
    "email": "bachagabriel@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielbacha/Tauri-React-Boilerplate.git"
  },
  "publish": {
    "provider": "github",
    "owner": "gabrielbacha",
    "repo": "Tauri-React-Boilerplate"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "@tauri-apps/plugin-os": "^2.4.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.40",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}

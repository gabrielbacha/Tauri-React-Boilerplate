# Local release credentials. Copy to .env.local and export before `pnpm run release`; never commit real values.
# Tauri does not load this file automatically.

# Updater signatures (required for update feeds). Create a key with: pnpm run setup --updater-key <path>
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS code signing and notarization
APPLE_SIGNING_IDENTITY=
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=

# Publishing with `pnpm run release -- --publish`
GH_TOKEN=

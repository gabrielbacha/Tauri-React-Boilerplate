{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["DOM", "ES2023"],
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*", "vite.config.ts", "vitest.config.ts", "package.json", "tests/**/*.ts"]
}

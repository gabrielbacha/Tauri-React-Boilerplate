{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["DOM", "ES2023"],
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@desktop/*": ["./src/*"],
      "@contracts/*": ["./packages/desktop-contracts/src/*"]
    },
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": [
    "src/**/*",
    "packages/desktop-contracts/src/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "package.json",
    "tests/**/*.ts"
  ]
}
